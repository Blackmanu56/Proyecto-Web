# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - CHOPPER REPUESTOS (SGI)
# Copiá este archivo a `.env` y completá con las credenciales de Supabase.
# ==============================================================================

# 1. Supabase PostgreSQL - Runtime (Connection Pooler / Transaction mode - puerto 6543)
# Obtener de Supabase Dashboard: Project Settings > Database > Connection string > URI > Modo "Transaction"
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Supabase PostgreSQL - Migraciones CLI (Direct / Session mode - puerto 5432)
# Obtener de Supabase Dashboard: Project Settings > Database > Connection string > URI > Modo "Session" (puerto 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 3. Firma de Sesión y Autenticación JWT
# Secreto aleatorio seguro para firmar las cookies de sesión (ej. generado con openssl rand -base64 32)
JWT_SECRET="tu-clave-secreta-jwt-debe-ser-segura-y-aleatoria"

# 4. Opcional: Logs de Prisma en desarrollo ("true" para depuración de queries)
PRISMA_LOG_QUERIES="false"
