# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - CHOPPER REPUESTOS (SGI)
# Copiá este archivo a `.env` y completá con tus credenciales de Neon y Cloudflare R2.
# ==============================================================================

# 1. Neon PostgreSQL - Runtime (Connection Pooler)
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT]-pooler.[REGION].aws.neon.tech/neondb?sslmode=require"

# 2. Neon PostgreSQL - Migraciones CLI (Direct connection)
DIRECT_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT].[REGION].aws.neon.tech/neondb?sslmode=require"

# 3. Firma de Sesión y Autenticación JWT
JWT_SECRET="tu-clave-secreta-jwt-debe-ser-segura-y-aleatoria"

# 4. Cloudflare R2 Storage (almacenamiento compartido de catálogo y perfiles)
R2_ACCOUNT_ID="tu-account-id"
R2_ACCESS_KEY_ID="tu-access-key-id"
R2_SECRET_ACCESS_KEY="tu-secret-access-key"
R2_BUCKET_NAME="chopper-storage"
R2_ENDPOINT="https://[ACCOUNT_ID].r2.cloudflarestorage.com"
R2_PUBLIC_URL="https://pub-[HASH].r2.dev"

# 5. Opcional: Logs de Prisma en desarrollo ("true" para depuración de queries)
PRISMA_LOG_QUERIES="false"
