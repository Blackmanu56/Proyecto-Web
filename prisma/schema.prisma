generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EstadoProducto {
  ACTIVO
  INACTIVO
}

enum MotivoEstadoProducto {
  VENCIDO
  DEFECTUOSO
  DISCONTINUADO
  BAJA_TEMPORAL
  YA_NO_SE_COMERCIALIZA
  OTRO
  REACTIVACION
}

enum OrigenPagoCompra {
  EFECTIVO_CAJA
  TRANSFERENCIA_BANCARIA
  CUENTA_CORRIENTE_PROVEEDOR
  FONDOS_EXTERNOS
}

enum TipoCuentaFinanciera {
  BANCO
  POR_ACREDITAR
  BILLETERA
  OTRA
}

enum TipoMovimientoFinanciero {
  INGRESO
  EGRESO
}

enum TipoMovimientoProducto {
  COMPRA
  VENTA
  RESTA_MANUAL
  EDICION
  REPOSICION_DIRECTA
  REPOSICION_APROBADA
}

enum TipoSolicitudStock {
  RESTA
  REPOSICION
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum TipoNotificacion {
  SOLICITUD_CREADA
  SOLICITUD_APROBADA
  SOLICITUD_RECHAZADA
}

model PagoCompra {
  id          Int      @id @default(autoincrement())
  compraId    Int      @map("compra_id")
  medio       String // EFECTIVO_CAJA, TRANSFERENCIA_BANCARIA, MERCADO_PAGO, CUENTA_CORRIENTE_PROVEEDOR, FONDOS_EXTERNOS
  monto       Float
  observacion String?
  createdAt   DateTime @default(now()) @map("created_at")
  compra      Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)

  @@map("pagos_compra")
}

model Rol {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  permisos String?
  usuarios Usuario[]

  @@map("roles")
}

model Usuario {
  id                     Int                    @id @default(autoincrement())
  username               String                 @unique
  passwordHash           String                 @map("password_hash")
  nombreCompleto         String                 @map("nombre_completo")
  dni                    String                 @unique
  correo                 String?
  telefono               String?
  activo                 Boolean                @default(true)
  creadoEn               DateTime               @default(now()) @map("creado_en")
  rolId                  Int                    @map("rol_id")
  fotoActualizadaEn      DateTime?              @map("foto_actualizada_en")
  fotoUrl                String?                @map("foto_url")
  cajas                  Caja[]
  compras                Compra[]
  empleado               Empleado?
  movimientos            MovimientoCaja[]
  favoritos              ProductoFavorito[]
  historialEstados       HistorialEstado[]
  movimientosFinancieros MovimientoFinanciero[]
  movimientosProducto    MovimientoProducto[]
  rol                    Rol                    @relation(fields: [rolId], references: [id])
  ventas                 Venta[]
  solicitudesSolicitante     SolicitudReposicion[]  @relation("solicitudesSolicitante")
  solicitudesAprobador       SolicitudReposicion[]  @relation("solicitudesAprobador")
  solicitudesStockCreadas    SolicitudStock[]       @relation("SolicitudStockSolicitante")
  solicitudesStockResueltas  SolicitudStock[]       @relation("SolicitudStockResuelto")
  notificaciones             Notificacion[]

  @@map("usuarios")
}

model Empleado {
  id        Int      @id @default(autoincrement())
  nombre    String
  apellido  String
  cargo     String
  usuarioId Int?     @unique @map("usuario_id")
  activo    Boolean  @default(true)
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("empleados")
}

model Cliente {
  id        Int      @id @default(autoincrement())
  nombre    String
  dni       String   @unique
  telefono  String?
  direccion String?
  email     String?
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now()) @map("creado_en")
  cuit      String?  @unique
  ventas    Venta[]

  @@map("clientes")
}

model Proveedor {
  id                    Int                   @id @default(autoincrement())
  nombre                String
  telefono              String?
  direccion             String?
  email                 String?
  cuit                  String                @unique
  activo                Boolean               @default(true)
  contactoResponsable   String?               @map("contacto_responsable")
  creadoEn              DateTime              @default(now()) @map("creado_en")
  compras               Compra[]
  productos             Producto[]
  solicitudesReposicion SolicitudReposicion[]

  @@map("proveedores")
}

model Categoria {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  activo    Boolean    @default(true)
  productos Producto[]

  @@map("categorias")
}

model Producto {
  id                    Int                   @id @default(autoincrement())
  nombre                String
  categoriaId           Int                   @map("categoria_id")
  precioCompra          Float                 @map("precio_compra")
  precioVenta           Float                 @map("precio_venta")
  cantidad              Int                   @default(0)
  stockMinimo           Int                   @default(0) @map("stock_minimo")
  proveedorId           Int                   @map("proveedor_id")
  activo                Boolean               @default(true)
  codigo                String?
  imagen                String?
  marca                 String?
  marcaId               Int?                  @map("marca_id")
  detalleCompras        DetalleCompra[]
  detalleVentas         DetalleVenta[]
  categoria             Categoria             @relation(fields: [categoriaId], references: [id])
  proveedor             Proveedor             @relation(fields: [proveedorId], references: [id])
  marcaRelacionada      Marca?                @relation(fields: [marcaId], references: [id])
  favoritos             ProductoFavorito[]
  historialEstados      HistorialEstado[]
  movimientosProducto   MovimientoProducto[]
  solicitudesReposicion SolicitudReposicion[]
  solicitudesStock      SolicitudStock[]

  @@map("productos")
}

model Marca {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  activo    Boolean    @default(true)
  productos Producto[]

  @@map("marcas")
}

model Venta {
  id                     Int                    @id @default(autoincrement())
  clienteId              Int                    @map("cliente_id")
  usuarioId              Int                    @map("usuario_id")
  total                  Float                  @default(0.0)
  fecha                  DateTime               @default(now())
  estado                 String                 @default("COMPLETADA")
  metodoPago             String?                @map("metodo_pago")
  descuentoTipo          String?                @map("descuento_tipo")
  montoDescuento         Float                  @default(0.0) @map("monto_descuento")
  tipoComprobante        String?                @map("tipo_comprobante")
  cuotas                 Int?                   @map("cuotas")
  detalles               DetalleVenta[]
  movimientos            MovimientoCaja[]
  movimientosFinancieros MovimientoFinanciero[]
  movimientosProducto    MovimientoProducto[]
  cliente                Cliente                @relation(fields: [clienteId], references: [id])
  usuario                Usuario                @relation(fields: [usuarioId], references: [id])

  @@map("ventas")
}

model DetalleVenta {
  id             Int      @id @default(autoincrement())
  ventaId        Int      @map("venta_id")
  productoId     Int      @map("producto_id")
  cantidad       Int
  precioUnitario Float    @map("precio_unitario")
  subtotal       Float
  producto       Producto @relation(fields: [productoId], references: [id])
  venta          Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  @@map("detalle_ventas")
}

model Caja {
  id                Int              @id @default(autoincrement())
  usuarioId         Int              @map("usuario_id")
  fechaApertura     DateTime         @default(now()) @map("fecha_apertura")
  fechaCierre       DateTime?        @map("fecha_cierre")
  montoInicial      Float            @map("monto_inicial")
  totalVentas       Float            @default(0.0) @map("total_ventas")
  estado            String           @default("ABIERTA")
  gastosManuales    Float            @default(0.0) @map("gastos_manuales")
  totalContado      Float?           @map("total_contado")
  observacionCierre String?          @map("observacion_cierre")
  usuario           Usuario          @relation(fields: [usuarioId], references: [id])
  movimientos       MovimientoCaja[]

  @@map("cajas")
}

model MovimientoCaja {
  id          Int      @id @default(autoincrement())
  cajaId      Int      @map("caja_id")
  usuarioId   Int      @map("usuario_id")
  ventaId     Int?     @map("venta_id")
  compraId    Int?     @map("compra_id")
  tipo        String
  monto       Float
  descripcion String
  fecha       DateTime @default(now())
  caja        Caja     @relation(fields: [cajaId], references: [id], onDelete: Cascade)
  compra      Compra?  @relation(fields: [compraId], references: [id])
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])
  venta       Venta?   @relation(fields: [ventaId], references: [id])

  @@map("movimientos_caja")
}

model Compra {
  id                     Int                    @id @default(autoincrement())
  proveedorId            Int                    @map("proveedor_id")
  usuarioId              Int                    @map("usuario_id")
  total                  Float                  @default(0.0)
  fecha                  DateTime               @default(now())
  origenPago             OrigenPagoCompra       @default(EFECTIVO_CAJA) @map("origen_pago")
  proveedor              Proveedor              @relation(fields: [proveedorId], references: [id])
  usuario                Usuario                @relation(fields: [usuarioId], references: [id])
  detalles               DetalleCompra[]
  movimientos            MovimientoCaja[]
  pagos                  PagoCompra[]
  movimientosFinancieros MovimientoFinanciero[]
  movimientosProducto    MovimientoProducto[]
  solicitudReposicion    SolicitudReposicion?

  @@map("compras")
}

model DetalleCompra {
  id            Int      @id @default(autoincrement())
  compraId      Int      @map("compra_id")
  productoId    Int      @map("producto_id")
  cantidad      Int
  costoUnitario Float    @map("costo_unitario")
  subtotal      Float
  compra        Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  producto      Producto @relation(fields: [productoId], references: [id])

  @@map("detalle_compras")
}

model SolicitudReposicion {
  id            Int              @id @default(autoincrement())
  productoId    Int              @map("producto_id")
  cantidad      Int
  costoUnitario Float            @map("costo_unitario")
  total         Float
  proveedorId   Int              @map("proveedor_id")
  estado        String           @default("PENDIENTE") // PENDIENTE|APROBADA|RECHAZADA
  origenPago    OrigenPagoCompra @default(EFECTIVO_CAJA) @map("origen_pago")
  pagos         Json?
  motivo        String?
  respuesta     String?
  solicitanteId Int              @map("solicitante_id")
  aprobadorId   Int?             @map("aprobador_id")
  compraId      Int?             @unique @map("compra_id")
  createdAt     DateTime         @default(now()) @map("created_at")
  resueltoEn    DateTime?        @map("resuelto_en")
  producto      Producto         @relation(fields: [productoId], references: [id])
  proveedor     Proveedor        @relation(fields: [proveedorId], references: [id])
  solicitante   Usuario          @relation("solicitudesSolicitante", fields: [solicitanteId], references: [id])
  aprobador     Usuario?         @relation("solicitudesAprobador", fields: [aprobadorId], references: [id])
  compra        Compra?          @relation(fields: [compraId], references: [id])

  @@index([estado, createdAt])
  @@index([productoId])
  @@map("solicitudes_reposicion")
}

model SolicitudStock {
  id                     Int                 @id @default(autoincrement())
  productoId             Int
  tipo                   TipoSolicitudStock
  cantidad               Int
  stockAnterior          Int
  motivo                 String
  estado                 EstadoSolicitud     @default(PENDIENTE)
  solicitanteId          Int
  resueltoPorId          Int?
  observacionResolucion  String?
  createdAt              DateTime            @default(now())
  resolvedAt             DateTime?

  producto               Producto            @relation(fields: [productoId], references: [id], onDelete: Restrict)
  solicitante            Usuario             @relation("SolicitudStockSolicitante", fields: [solicitanteId], references: [id], onDelete: Restrict)
  resueltoPor            Usuario?            @relation("SolicitudStockResuelto", fields: [resueltoPorId], references: [id], onDelete: SetNull)
  notificaciones         Notificacion[]

  @@index([productoId])
  @@index([solicitanteId])
  @@index([estado])
  @@index([createdAt])
  @@map("solicitudes_stock")
}

model Notificacion {
  id                 Int                 @id @default(autoincrement())
  usuarioId          Int
  tipo               TipoNotificacion
  titulo             String
  mensaje            String
  solicitudStockId   Int?
  leida              Boolean             @default(false)
  createdAt          DateTime            @default(now())
  readAt             DateTime?

  usuario            Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  solicitudStock     SolicitudStock?     @relation(fields: [solicitudStockId], references: [id], onDelete: SetNull)

  @@index([usuarioId, leida])
  @@index([createdAt])
  @@map("notificaciones")
}

model ProductoFavorito {
  id         Int      @id @default(autoincrement())
  usuarioId  Int      @map("usuario_id")
  productoId Int      @map("producto_id")
  creadoEn   DateTime @default(now()) @map("creado_en")
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, productoId])
  @@map("productos_favoritos")
}

model HistorialEstado {
  id             Int                  @id @default(autoincrement())
  productoId     Int                  @map("producto_id")
  producto       Producto             @relation(fields: [productoId], references: [id], onDelete: Restrict)
  estadoAnterior EstadoProducto       @map("estado_anterior")
  estadoNuevo    EstadoProducto       @map("estado_nuevo")
  motivo         MotivoEstadoProducto
  observacion    String?
  fecha          DateTime             @default(now())
  usuarioId      Int                  @map("usuario_id")
  usuario        Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([productoId, fecha])
  @@index([usuarioId])
  @@map("historial_estado_producto")
}

model CuentaFinanciera {
  id           Int                    @id @default(autoincrement())
  nombre       String
  tipo         TipoCuentaFinanciera
  saldoInicial Float                  @default(0.0) @map("saldo_inicial")
  activa       Boolean                @default(true)
  esPrincipal  Boolean                @default(false) @map("es_principal")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  movimientos  MovimientoFinanciero[]

  @@map("cuentas_financieras")
}

model MovimientoFinanciero {
  id                 Int                      @id @default(autoincrement())
  cuentaFinancieraId Int                      @map("cuenta_financiera_id")
  tipo               TipoMovimientoFinanciero
  monto              Float
  fecha              DateTime                 @default(now())
  descripcion        String
  usuarioId          Int?                     @map("usuario_id")
  ventaId            Int?                     @map("venta_id")
  compraId           Int?                     @map("compra_id")
  referencia         String?
  createdAt          DateTime                 @default(now()) @map("created_at")
  cuentaFinanciera   CuentaFinanciera         @relation(fields: [cuentaFinancieraId], references: [id], onDelete: Restrict)
  usuario            Usuario?                 @relation(fields: [usuarioId], references: [id])
  venta              Venta?                   @relation(fields: [ventaId], references: [id])
  compra             Compra?                  @relation(fields: [compraId], references: [id])

  @@index([cuentaFinancieraId, fecha])
  @@index([ventaId])
  @@index([compraId])
  @@map("movimientos_financieros")
}

model MovimientoProducto {
  id               Int                    @id @default(autoincrement())
  productoId       Int                    @map("producto_id")
  usuarioId        Int                    @map("usuario_id")
  tipo             TipoMovimientoProducto
  cantidadAnterior Int                    @map("cantidad_anterior")
  cantidadNueva    Int                    @map("cantidad_nueva")
  compraId         Int?                   @map("compra_id")
  ventaId          Int?                   @map("venta_id")
  motivo           String
  observacion      String?
  cambios          Json?
  createdAt        DateTime               @default(now()) @map("created_at")

  producto         Producto               @relation(fields: [productoId], references: [id], onDelete: Restrict)
  usuario          Usuario                @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  compra           Compra?                @relation(fields: [compraId], references: [id])
  venta            Venta?                 @relation(fields: [ventaId], references: [id])

  @@index([productoId, createdAt])
  @@index([usuarioId])
  @@index([tipo])
  @@map("movimientos_producto")
}
